# ---------------------------------------------------------------------------
# Help desk configuration. Copy to .env and fill in. See docs/SETUP.md.
# ---------------------------------------------------------------------------

# Public URL users browse to (web app and API are served from the same origin in production)
APP_URL=https://helpdesk.example.com
API_URL=https://helpdesk.example.com
# Long random string used to sign session cookies:  openssl rand -base64 48
SESSION_SECRET=
# Only for local development without Docker
DATABASE_URL=postgresql://helpdesk:change-me@localhost:5432/helpdesk
POSTGRES_PASSWORD=change-me

# --- Microsoft Entra ID (SSO) -----------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# App role values defined on the app registration
ENTRA_ADMIN_ROLE=Helpdesk.Admin
ENTRA_AGENT_ROLE=Helpdesk.Agent
# true  = roles always come from Entra app roles (recommended)
# false = roles can be managed on the Users admin page
ENTRA_ROLES_AUTHORITATIVE=true
# Comma separated emails that are always admins (useful for first setup)
BOOTSTRAP_ADMIN_EMAILS=

# --- Email ------------------------------------------------------------------
# The support mailbox people send tickets to
MAIL_ADDRESS=helpdesk@example.com
MAIL_FROM_NAME=IT Help Desk
# Inbound: gmail (Google Workspace) | graph (Microsoft 365) | imap | none
MAIL_INBOUND=gmail
# Outbound: gmail | graph | smtp | log (log = print emails to the console)
MAIL_OUTBOUND=gmail
MAIL_POLL_SECONDS=60

# Gmail (Google Workspace) — see docs/SETUP.md section 2
# service_account = domain-wide delegation (simplest) | oauth = refresh token for the help desk mailbox only
GMAIL_AUTH=service_account
# For service_account: path to the JSON key (mounted into the container) OR the JSON itself / base64 of it
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/run/secrets/google-sa.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# For oauth: Desktop-app OAuth client + token from `npm run gmail:authorize -w server`
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Label applied to imported mail, and whether to archive it out of the Inbox
GMAIL_PROCESSED_LABEL=Helpdesk/Processed
GMAIL_ARCHIVE=true
# Optional extra Gmail search filter, e.g. -category:promotions
GMAIL_QUERY=

# Microsoft 365 only: move processed mail into this folder
GRAPH_PROCESSED_FOLDER=
# Optional: only accept new tickets from these sender domains (comma separated)
MAIL_ALLOWED_DOMAINS=

# IMAP / SMTP (only when MAIL_INBOUND=imap or MAIL_OUTBOUND=smtp)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: accept raw MIME POSTs at /inbound/email?secret=...
INBOUND_WEBHOOK_SECRET=

# --- Chrome extension -------------------------------------------------------
# Restrict API CORS to your extension, e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop
EXTENSION_ORIGINS=

# --- Misc -------------------------------------------------------------------
MAX_UPLOAD_MB=25
# Local development only: shows a "dev sign-in" form on the login page
DEV_LOGIN=false
