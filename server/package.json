    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.11.0",
    "jose": "^6.2.17",
    "mailparser": "^3.14.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "prisma": "^6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
